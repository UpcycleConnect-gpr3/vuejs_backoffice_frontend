# Copiez ce fichier en .env et adaptez les URLs a votre environnement.
# --- Dev local (backends lances directement sur leurs ports) ---
VITE_AUTH_URL=http://localhost:4242
VITE_FORUM_URL=http://localhost:4444
VITE_TRAINING_URL=http://localhost:4445
VITE_UPCYCLE_URL=http://localhost:4343
VITE_AUTH_REDIRECT_URL=http://localhost:4284
VITE_COOKIE_DOMAIN=localhost
VITE_COOKIE_PATH=/

